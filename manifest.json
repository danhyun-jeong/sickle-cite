{
  "manifest_version": 3,
  "name": "Sickle-Cite",
  "version": "2.0.0",
  "icons": {
    "128": "icons/icon128.png"
  },
  "description": "국내 인문학(국문학) 분야의 관습적 인용 양식을 지원하는, 한국어 논문에 최적화된 서지사항 메타데이터 추출기 겸 인용 표기 생성기입니다.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "commands":{
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://*.riss.kr/search/detail/DetailView.do*",
    "https://www.kci.go.kr/kciportal/ci/sereArticleSearch/ciSereArtiView*",
    "https://www.kci.go.kr/kciportal/landing/article.kci*",
    "https://*.kiss.kstudy.com/Detail*/Ar*",
    "https://*.dbpia.co.kr/journal/articleDetail*",
    "https://*.dbpia.co.kr/journal/detail*",
    "https://*.earticle.net/Article/*",
    "https://*.scholar.kyobobook.co.kr/article/detail/*"
  ]
}