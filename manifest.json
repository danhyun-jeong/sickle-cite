{
  "manifest_version": 3,
  "name": "Sickle-Cite",
  "version": "1.7.7",
  "icons": {
    "128": "icons/icon128.png"
  },
  "description": "국내 인문학(국문학) 분야의 관습적 인용 양식을 지원하는, 한국어 논문에 최적화된 서지사항 메타데이터 추출기 겸 인용 표기 생성기입니다.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      }
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.riss.kr/*",
    "https://*.kci.go.kr/*",
    "https://*.kiss.kstudy.com/*",
    "https://*.dbpia.com/*",
    "https://*.dbpia.co.kr/*",
    "https://*.earticle.net/*",
    "https://*.scholar.kyobobook.co.kr/*",
    "https://*.koreascience.or.kr/*",
    "https://scienceon.kisti.re.kr/*",
    "https://*.krm.or.kr/*",
    "https://*.dcollection.net/*",
    "https://history.seoul.go.kr/*",
    "https://*.heritage.go.kr/*",
    "https://*.cha.go.kr/*",
    "https://*.khs.go.kr/*",
    "https://*.e-minwon.go.kr/*",
    "https://*.nrich.go.kr/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.riss.kr/*",
        "https://*.kci.go.kr/*",
        "https://*.kiss.kstudy.com/*",
        "https://*.dbpia.com/*",
        "https://*.dbpia.co.kr/*",
        "https://*.earticle.net/*",
        "https://*.scholar.kyobobook.co.kr/*",
        "https://*.koreascience.or.kr/*",
        "https://scienceon.kisti.re.kr/*",
        "https://*.krm.or.kr/*",
        "https://*.dcollection.net/*",
        "https://history.seoul.go.kr/*",
        "https://*.heritage.go.kr/*",
        "https://*.cha.go.kr/*",
        "https://*.khs.go.kr/*",
        "https://*.e-minwon.go.kr/*",
        "https://*.nrich.go.kr/*"
      ],
      "js": [
        "filename_tools.js",
        "content_script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
